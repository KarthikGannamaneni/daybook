# ---------------------------------------------------------------------------
# Khata environment variables. Copy to .env.local (web) / supabase/.env (edge).
# Nothing here is secret; every real value is injected at deploy time.
# ---------------------------------------------------------------------------

# Supabase project URL. Local stack default shown; use https://<ref>.supabase.co in prod.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon key. Safe to ship to the browser; all access is gated by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. EDGE FUNCTIONS ONLY. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API: the phone number id of the business number.
WHATSAPP_PHONE_NUMBER_ID=
# Permanent system-user access token (not the 24h temporary dev token).
WHATSAPP_ACCESS_TOKEN=
# App secret used to verify the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=
# Random string echoed back during Meta's webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=
# 1 = do not call Meta; log outbound messages to whatsapp_messages instead.
MOCK_WHATSAPP=1

# 1 = run the web app against a local in-browser dataset, no Supabase needed.
# Used for `pnpm dev:demo`, the Playwright suite, and the hosted demo build.
NEXT_PUBLIC_DEMO_MODE=0
