# Local edge-function environment. Copy to supabase/.env (gitignored) and run:
#   supabase functions serve --env-file supabase/.env --no-verify-jwt
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the CLI locally.
MOCK_WHATSAPP=1
WHATSAPP_APP_SECRET=local-dev-secret
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_ACCESS_TOKEN=
