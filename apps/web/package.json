{
  "name": "@khata/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:demo": "NEXT_PUBLIC_DEMO_MODE=1 next dev -p 3000",
    "dev:phone": "NEXT_PUBLIC_DEMO_MODE=1 next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "build:demo": "NEXT_PUBLIC_DEMO_MODE=1 next build",
    "start": "next start -p 3000",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:e2e:record": "RECORD_VIDEO=1 playwright test --project=mobile e2e/recordings.spec.ts"
  },
  "dependencies": {
    "@khata/parser": "workspace:*",
    "@khata/shared": "workspace:*",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@supabase/ssr": "0.5.1",
    "@supabase/supabase-js": "2.45.4",
    "@tanstack/react-query": "5.59.16",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "idb-keyval": "6.2.1",
    "jspdf": "2.5.2",
    "lucide-react": "0.454.0",
    "motion": "11.11.17",
    "next": "15.5.25",
    "next-intl": "3.23.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.8.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
