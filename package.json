{
  "name": "khata",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @khata/web dev",
    "dev:demo": "pnpm --filter @khata/web dev:demo",
    "dev:phone": "pnpm --filter @khata/web dev:phone",
    "build": "pnpm --filter @khata/web build",
    "start": "pnpm --filter @khata/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @khata/parser test && pnpm --filter @khata/shared test",
    "test:e2e": "pnpm --filter @khata/web test:e2e",
    "test:db": "supabase test db",
    "test:functions": "deno test -A supabase/functions",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:parser": "node scripts/sync-parser.mjs",
    "check:parser-sync": "node scripts/sync-parser.mjs --check",
    "check:bundle": "pnpm --filter @khata/web check:bundle"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}
